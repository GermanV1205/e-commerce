# Conexión a PostgreSQL. En local apunta al contenedor de docker-compose (puerto 5433
# para no chocar con una instalación nativa de PostgreSQL en el 5432).
DATABASE_URL="postgresql://admin:admin_password_seguro@127.0.0.1:5433/ecommerce?schema=public"

# Clave de firma de los JWT. Genera una propia con: openssl rand -base64 48
# La aplicación no arranca si falta.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Vigencia del access token (todavía no hay refresh token)
JWT_EXPIRES_IN="8h"

# Puerto de la API
PORT=3000

# Origen permitido por CORS (el frontend de Vite)
CORS_ORIGIN=http://localhost:5173

# URL pública desde la que se sirven las imágenes subidas
PUBLIC_URL=http://localhost:3000

# Credenciales del usuario ADMIN que genera `npm run db:seed`
SEED_ADMIN_EMAIL=admin@tienda.com
SEED_ADMIN_PASSWORD=Admin123!
