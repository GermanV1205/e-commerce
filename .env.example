# Variables que consume docker-compose.yml en la raíz del monorepo.
# Copia este archivo como .env antes de ejecutar `docker compose up -d`.

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_password_seguro
POSTGRES_DB=ecommerce

PGADMIN_EMAIL=admin@ecommerce.com
PGADMIN_PASSWORD=admin_password_seguro

# Obligatoria: el contenedor de la API no arranca sin ella.
# Genera una propia con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

CORS_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=/api/v1

# Cuenta bancaria que se muestra en el checkout
TRANSFER_BANK_NAME=Banco Pichincha
TRANSFER_ACCOUNT_TYPE=Ahorros
TRANSFER_ACCOUNT=2209453134
TRANSFER_HOLDER=Tienda de Ropa
TRANSFER_ID=
TRANSFER_CURRENCY=USD

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=ecommerce
S3_PUBLIC_URL=http://localhost:9000/ecommerce
STORAGE_DRIVER=s3

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TiendaRopa <noreply@tiendaropa.local>
SWAGGER_ENABLED=true
